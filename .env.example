# Copy this file to .env and fill in the values for the environment.
# .env is not in git. Never put real keys in this file.
# Do not wrap values in quotes: the API's loader keeps them as part of the value.

# Application
# local, staging or production. This changes behaviour, not only config:
# on local, all API email goes to APP_EMAIL and PHP errors are displayed.
# Production must be production.
APP_ENV=local
APP_EMAIL=
APP_LOGO=

# Signs the API login tokens. Use a long random value.
JWT_SECRET=

# Database (same database and table prefix as WordPress)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=wp_xzg4ax8u64_
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# GraphQL API credentials
GRAPHQL_PROD_APP_ID=
GRAPHQL_PROD_API_KEY=
GRAPHQL_STAGING_APP_ID=
GRAPHQL_STAGING_API_KEY=

# Scoring Engine API
SCORING_BASE_URL=
SCORING_APP_ID=
SCORING_API_KEY=
SCORING_TIMEOUT=10
SCORING_RETRIES=2
SCORING_RETRY_DELAY_MS=200

# Mail: set MAIL_DRIVER, then fill in the matching section
MAIL_DRIVER=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Four Temperaments

# Amazon SES API
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# SMTP (only when MAIL_DRIVER=smtp)
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# Google Sheets stats export (also needs credentials.json in this folder)
STATS_SHEET_ID=
# Comma-separated list of coupon codes
DIRECT_CODES=

# Mailjet
MAILJET_MINI_LIST_ID=

# Hours to hold a report job when chart images are missing
REPORT_HOLD_HOURS=6

# Stripe webhook signing secret (whsec_...) for POST /api/v1/webhooks/stripe (refunds, disputes).
# Normally saved in wp-admin: Plugin 1 Settings > Payments > Webhook Signing Secret.
# Used only when that setting is empty.
STRIPE_WEBHOOK_SECRET=
